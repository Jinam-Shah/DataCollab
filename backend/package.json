{
  "name": "backend",
  "version": "1.0.0",
  "description": "DataCollab Backend",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.js",
    "build": "tsc && node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx db/migrate.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "worker": "tsx watch worker.js",
    "start:worker": "node dist/worker.js",
    "seed:demo": "tsx scripts/seed_demo.ts",
    "fetch:demo-data": "node scripts/fetch_demo_data.js",
    "eval": "tsx eval/run.ts",
    "e2e:server": "tsx scripts/e2e_server.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "eval:retrieval": "tsx eval/retrieval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^1.2.18",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.17",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "libpg-query": "^18.1.5",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20.19"
  }
