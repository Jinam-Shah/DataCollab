PORT=5000
NODE_ENV=development

# Application login: owns the app tables and workspace schemas. Needs CREATEROLE.
DATABASE_URL=postgresql://datacollab:change_me@localhost:5432/datacollab
# Read-only login used for every user/agent query. Migration 002 creates this role
# with the password given here, a 5 s statement timeout and read-only transactions.
DATABASE_READER_URL=postgresql://datacollab_reader:change_me_too@localhost:5432/datacollab
# Run migrations when the server starts (useful on Render). Otherwise run `npm run migrate`.
RUN_MIGRATIONS=false
QUERY_TIMEOUT_MS=5000

JWT_SECRET=replace_with_a_long_random_string
# Comma-separated list of allowed browser origins in production.
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-* is not offered to new keys; see the models your key can use with
# curl https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: $GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash
